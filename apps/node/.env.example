# 拷成 .env 后填值，仅本地开发用；Actions 里走仓库 Secrets
SKLAND_TOKEN=

# 社区每日任务（版区检票 / 浏览 / 点赞）。留空即用默认值：checkin,view,like
# 整个关掉：SKLAND_COMMUNITY=off
# SKLAND_COMMUNITY_ACTIONS=checkin,view,like
# 只做部分版区，gameId 逗号分隔：1=明日方舟 2=来自星尘 3=终末地
# SKLAND_COMMUNITY_ZONES=
# SKLAND_COMMUNITY_VIEW=5
# SKLAND_COMMUNITY_LIKE=10
# SKLAND_COMMUNITY_SHARE=1
# SKLAND_COMMUNITY_INTERVAL=800

# 推送（任选其一）
# SERVERCHAN_SENDKEY=
# BARK_URL=
# MESSAGE_PUSHER_URL=
